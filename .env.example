# Copie para .env e troque as senhas:  cp .env.example .env
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Banco e role administrativa (dona do schema; usada pelo seed e manutenção)
POSTGRES_DB=tcc_nl2sql
POSTGRES_USER=tcc_admin
POSTGRES_PASSWORD=troque_esta_senha_admin

# Host/porta usados pelos scripts Python e clientes externos (porta publicada pelo Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Role somente leitura usada pelo n8n / experimentos NL2SQL
NL2SQL_READONLY_PASSWORD=troque_esta_senha_readonly

# Role de escrita do banco de registro dos experimentos (tcc_experiments).
# Usada somente pela interface web (rota /api/chat); NUNCA pelos workflows do n8n.
EXPERIMENT_WRITER_PASSWORD=troque_esta_senha_experimentos
